// TypeScript settings. `strict` catches mistakes early; the "@/..." path lets any file import from
// src/ without long ../../.. chains (e.g. `import { Page } from '@/components/layout/Page'`).
{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "nativewind-env.d.ts"]
}
